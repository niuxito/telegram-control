# systemd user service for Telegram Control.
#
# Runs as your own user (agents need your git, gh and CLI credentials), no sudo.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp scripts/telegram-control.service ~/.config/systemd/user/
#   # edit WorkingDirectory below if the repo is not at ~/telegram-control
#   systemctl --user daemon-reload
#   systemctl --user enable --now telegram-control
#
# Keep it running after you log out (needs to be done once):
#   loginctl enable-linger "$USER"
#
# Logs / restart:
#   journalctl --user -u telegram-control -f
#   systemctl --user restart telegram-control
#
# The bot exits on unrecoverable errors and relies on Restart=always.

[Unit]
Description=Telegram Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/telegram-control
# npm start puts node_modules/.bin (codex, opencode) on PATH
ExecStart=/usr/bin/env npm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Agent CLIs installed under ~/.local/bin or ~/.npm-global/bin must be on PATH
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin:/snap/bin

[Install]
WantedBy=default.target
