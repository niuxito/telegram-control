{
  "name": "telegram-control",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --disable-warning=DEP0040 dist/index.js",
    "start:pi": "NODE_ENV=production node --disable-warning=DEP0040 dist/index.js",
    "setup": "node --disable-warning=DEP0040 dist/index.js --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "NODE_OPTIONS=--disable-warning=DEP0040 vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=DEP0040 vitest",
    "install-service": "bash scripts/install-service.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@openai/codex": "^0.121.0",
    "better-sqlite3": "^11.0.0",
    "chokidar": "^4.0.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.3",
    "grammy": "^1.30.0",
    "node-cron": "^4.2.1",
    "simple-git": "^3.27.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.30.0",
    "opencode-ai": "^1.14.48",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
