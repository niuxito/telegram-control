# Required: token from @BotFather
BOT_TOKEN=

# Filled in automatically by pairing (/setup <code> on first start)
SUPERGROUP_ID=               # Supergroup ID (negative number)
NEW_PROJECTS_TOPIC_ID=       # Thread ID of the "New Projects" topic
OWNER_USER_ID=               # Your Telegram user ID

# Optional
ANTHROPIC_API_KEY=           # Only to use the Anthropic API instead of a Claude account
OPENAI_API_KEY=              # Enables voice messages (Whisper)
API_PORT=3001                # REST/SSE API port
API_HOST=127.0.0.1           # Listen address. Anything other than loopback requires API_KEY
API_KEY=                     # Bearer token for the API
PROJECTS_BASE_DIR=~/projects
DATA_DIR=./data
LOG_LEVEL=info
