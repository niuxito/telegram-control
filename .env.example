BOT_TOKEN=                   # De @BotFather
SUPERGROUP_ID=               # ID negativo del supergrupo
NEW_PROJECTS_TOPIC_ID=       # Thread ID del topic "New Projects"
OWNER_USER_ID=               # Tu Telegram user ID
ANTHROPIC_API_KEY=
OPENAI_API_KEY=           # Opcional: habilita mensajes de voz (Whisper)
API_PORT=3001             # Puerto de la API REST/SSE (default: 3001)
API_HOST=127.0.0.1        # Interfaz de escucha. Fuera de loopback exige API_KEY
API_KEY=                  # Bearer token. Obligatorio si API_HOST no es loopback
PROJECTS_BASE_DIR=~/projects
DATA_DIR=./data
LOG_LEVEL=info
